DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=gdutnic
MYSQL_USER=gdutnic
MYSQL_PASSWORD=replace-with-your-database-password
# Only needed by the local Docker MySQL service:
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
# For remote MySQL with TLS:
# MYSQL_SSL_CA=/absolute/path/to/ca.pem
# SESSION_SECRET=replace-with-a-long-random-secret
